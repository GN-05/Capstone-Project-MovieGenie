# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on. On Render, do not set it: Render chooses the port.
PORT=3000

# "production" on Render; leave it out on your own computer
# NODE_ENV=production

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the React app runs, exactly, with no trailing slash: only this origin
# may call the API (CORS). In production this is the Netlify address.
CLIENT_ORIGIN=https://your-site-name.netlify.app

# TMDB API key, the v3 "API Key" from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
