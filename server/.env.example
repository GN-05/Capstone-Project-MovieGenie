# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on
PORT=3000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the React app runs (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# TMDB API key, the v3 "API Key" from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
